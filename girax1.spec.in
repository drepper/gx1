# Template of the spec file; make rpm fills in the version from girax1/__init__.py.

# The script finds its modules in the directory it is in, which the -P flag
# Python is normally started with in a package would prevent.
%global py3_shebang_flags s

Name:           girax1
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Programs and libraries to control a Gira X1

License:        CC-BY-NC-ND-4.0
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  python3-devel
BuildRequires:  desktop-file-utils
BuildRequires:  gcc-c++
BuildRequires:  make
BuildRequires:  pkgconfig(gnutls)
BuildRequires:  pkgconfig(jsoncpp)
BuildRequires:  tomlplusplus-devel

# The program was part of this package up to version 0.2, so requiring its
# package now keeps it installed across the upgrade.
Requires:       %{name}-x1 = %{version}-%{release}

%description
Programs and libraries to control and query a Gira X1 home automation
server over its Device Stack API.  This package holds the documentation and
pulls in the x1 program.

The C++ library makes the build specific to the architecture, and RPM cannot
make the main package noarch while others are not.  This package therefore
holds nothing but documentation, and the program, written in Python, is in
the noarch package girax1-x1.

%package x1
Summary:        Control a Gira X1 from the command line or a small GUI
BuildArch:      noarch
# The type parameter syntax of generic functions needs Python 3.12.
Requires:       python3 >= 3.12
# Only the gui command needs Tk.
Recommends:     python3-tkinter
# Owns the directories the icon is installed into.
Requires:       hicolor-icon-theme

%description x1
The x1 program controls and queries a Gira X1 over its Device Stack API:
switching and dimming lights, driving coverings, showing the status of
devices and programming their switch times, from the command line or from a
graphical interface.  The connection details are read from
~/.config/girax1.toml.

%package libs
Summary:        C++ library to control a Gira X1

%description libs
A C++ library to control and query a Gira X1 over its Device Stack API, the
protocol the Gira Smart Home app uses: reading the project, switching and
dimming lights, driving coverings and programming switch times.

%package devel
Summary:        Files to build programs with the girax1 C++ library
Requires:       %{name}-libs%{?_isa} = %{version}-%{release}

%description devel
Headers, the shared library link, the static library and the pkg-config file
needed to build C++ programs which use the girax1 library.  The headers need
C++23 or later.

%prep
%autosetup

%build
# Only the library; the C++ version of the x1 program is not packaged, since
# the Python one is installed under that name.
%make_build lib

%install
%make_install prefix=%{_prefix} libdir=%{_libdir} includedir=%{_includedir}
# The library modules x1 needs are kept in a private directory instead of
# the system site-packages.  The program in the bin directory is a symbolic
# link to the script, and Python resolves it when setting up the search
# path, so the modules next to the script are found.
install -d %{buildroot}%{_datadir}/%{name}/girax1 %{buildroot}%{_bindir}
install -p -m 0755 x1.py %{buildroot}%{_datadir}/%{name}/x1.py
install -p -m 0644 girax1/__init__.py girax1/appearance.py girax1/config.py girax1/gui.py \
        girax1/project.py girax1/schedule.py girax1/stack.py girax1/timer.py \
        girax1/websocket.py girax1/x1.py %{buildroot}%{_datadir}/%{name}/girax1/
%py3_shebang_fix %{buildroot}%{_datadir}/%{name}/x1.py
ln -s ../share/%{name}/x1.py %{buildroot}%{_bindir}/x1
desktop-file-install --dir=%{buildroot}%{_datadir}/applications \
        data/org.akkadia.girax1.desktop
install -D -p -m 0644 data/org.akkadia.girax1.svg \
        %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/org.akkadia.girax1.svg
%py_byte_compile %{python3} %{buildroot}%{_datadir}/%{name}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/org.akkadia.girax1.desktop

%files
%license LICENSE
%doc README.md

%files x1
%license LICENSE
%doc girax1.toml.example
%{_bindir}/x1
%{_datadir}/%{name}
%{_datadir}/applications/org.akkadia.girax1.desktop
%{_datadir}/icons/hicolor/scalable/apps/org.akkadia.girax1.svg

%files libs
%license LICENSE
%{_libdir}/libgirax1.so.1
%{_libdir}/libgirax1-%{version}.so

%files devel
%{_includedir}/girax1/
%{_libdir}/libgirax1.so
%{_libdir}/libgirax1.a
%{_libdir}/pkgconfig/girax1.pc

%changelog
* Wed Oct 14 2026 Ulrich Drepper <github@akkadia.org> - 0.3-1
- Move the x1 program into the noarch package girax1-x1; girax1 only holds
  the documentation and requires it.

* Wed Oct 14 2026 Ulrich Drepper <github@akkadia.org> - 0.2-1
- Add the C++ library in the libs and devel subpackages.

* Wed Oct 14 2026 Ulrich Drepper <github@akkadia.org> - 0.1-1
- First package, holding the x1 program.
